---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

// Import custom MDX components
import BlogImage from "../../components/BlogImage.astro";
import BlogGallery from "../../components/BlogGallery.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// FIXED: Reduced to exactly 1 argument as expected by Astro
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  articleDate={post.data.pubDate.toISOString()}
>
  <section class="max-w-6xl mx-auto px-8 py-16 md:py-24 w-full">
    <article class="space-y-16">
      
      <!-- MAIN SPLIT COMPOSITION: 8-Column Content / 4-Column Sticky Image -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start w-full">
        
        <!-- LEFT COLUMN (8/12): Content Engine Canvas -->
        <div class="lg:col-span-8 order-2 lg:order-1 group/header">
          
          <!-- Editorial Header -->
          <header class="mb-10 text-left border-b border-warm/40 pb-8 relative">
            <span class="step-line w-6 group-hover/header:w-16 transition-all duration-500 ease-out mb-4"></span>
            
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[10px] font-bold tracking-widest text-muted uppercase block mt-2"
            >
              {post.data.pubDate.toLocaleDateString("en-US", { dateStyle: "long" })}
            </time>
            
            <h1 class="font-display mt-4 text-4xl md:text-5xl font-medium tracking-tight text-ink leading-tight">
              {post.data.title}
            </h1>
            <p class="mt-6 text-xs text-muted font-mono italic">By {post.data.author}</p>
          </header>

          <!-- Content Space -->
          <div class="prose prose-stone font-sans prose-lg prose-headings:font-display prose-headings:font-medium prose-a:text-orange hover:prose-a:text-ink max-w-none text-ink leading-relaxed">
            <!-- FIXED: Custom MDX components are mapped explicitly right here -->
            <Content components={{ BlogImage, BlogGallery }} />
          </div>
        </div>

        <!-- RIGHT COLUMN (4/12): Compact Floating Hero Artwork Asset -->
        <div class="lg:col-span-4 order-1 lg:order-2 w-full sticky top-24">
          {
            post.data.heroImage && (
              <div class="overflow-hidden rounded-sm border border-warm bg-warm/20 shadow-sm w-full">
                <Image
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  width={500}
                  height={666}
                  loading="eager"
                  class="w-full h-auto object-cover aspect-[3/4] hover:scale-[1.01] transition-transform duration-700 ease-out"
                />
              </div>
            )
          }
        </div>

      </div>

      <!-- BASE FOOTER RETREAT ACTION NAVIGATION -->
      <div class="w-full pt-8 border-t border-warm/40">
        <div class="mt-4">
          <a
            href="/blog"
            class="group inline-flex items-center gap-4 text-[11px] font-bold tracking-widest uppercase text-muted hover:text-ink transition-colors duration-300"
          >
            <span class="step-line w-6 group-hover:w-12 transition-all duration-300"></span>
            <span class="flex items-center gap-2">
              Back to Archive &rarr;
            </span>
          </a>
        </div>
      </div>

    </article>
  </section>
</BaseLayout>