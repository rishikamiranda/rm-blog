---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

// Import custom MDX components
import BlogImage from "../../components/BlogImage.astro";
import BlogGallery from "../../components/BlogGallery.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  articleDate={post.data.pubDate.toISOString()}
>
  <section class="max-w-6xl mx-auto px-8 py-10 md:py-10 w-full">
    <article class="space-y-12">
      
      <!-- 1. FULL WIDTH HEADER BLOCK (Title, Author, Date) -->
      <header class="text-left border-b border-warm/40 pb-8 relative group/header w-full">
        <!-- Interactive signature orange line that expands on header element hover states -->
        <span class="step-line w-6 group-hover/header:w-20 transition-all duration-500 ease-out mb-4"></span>
        
        
        
        <h1 class="font-display mt-4 text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-ink leading-tight max-w-4xl">
          {post.data.title}
        </h1>
        
        <p class="mt-6 text-xs flex text-muted  font-mono italic">
          <span>{post.data.pubDate.toLocaleDateString("en-US", { dateStyle: "long" })}</span>
          <span>By {post.data.author}</span>
        </p>
      </header>

      <!-- 2. DUAL COLUMN LAYOUT SYSTEM -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start w-full pt-4">
        
        <!-- LEFT COLUMN (8/12): Complete Content Canvas -->
        <div class="lg:col-span-8 w-full">
          <div class="prose prose-stone font-sans prose-lg prose-headings:font-display prose-headings:font-medium prose-a:text-orange hover:prose-a:text-ink max-w-none text-ink leading-relaxed">
            <Content components={{ BlogImage, BlogGallery }} />
          </div>
        </div>

        <!-- RIGHT COLUMN (4/12): Clean Vertical Gallery Asset Stack (Hidden entirely on mobile viewports) -->
        <div class="hidden lg:flex lg:col-span-4 flex-col gap-y-8 w-full">
          {
            post.data.images && post.data.images.length > 0 && (
              post.data.images.map((img) => (
                <div class="overflow-hidden rounded-sm border border-warm bg-warm/20 shadow-3xs w-full group/frame">
                  <Image
                    src={img.src}
                    alt={img.alt}
                    width={500}
                    height={666}
                    loading="eager"
                    class="w-full h-auto object-cover aspect-[3/4] hover:scale-[1.01] transition-transform duration-700 ease-out"
                  />
                </div>
              ))
            )
          }
        </div>

      </div>

      <!-- BASE ACTIONS RETREAT ROW -->
      <div class="w-full pt-12 border-t border-warm/40">
        <div class="mt-2">
          <a
            href="/blog"
            class="group inline-flex items-center gap-4 text-[11px] font-bold tracking-widest uppercase text-muted hover:text-ink transition-colors duration-300"
          >
            <span class="step-line w-6 group-hover:w-12 transition-all duration-300"></span>
            <span class="flex items-center gap-2">
              Back to Archive &rarr;
            </span>
          </a>
        </div>
      </div>

    </article>
  </section>
</BaseLayout>