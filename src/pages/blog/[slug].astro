---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  articleDate={post.data.pubDate.toISOString()}
>
  <section class="max-w-6xl mx-auto px-8 py-16 md:py-24 w-full">
    <article class="space-y-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start w-full">
        
        <div class="lg:col-span-8 order-2 lg:order-1">
          
          <header class="mb-10 text-left border-b border-warm/40 pb-8">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[10px] font-bold tracking-widest text-muted uppercase"
            >
              {post.data.pubDate.toLocaleDateString("en-US", { dateStyle: "long" })}
            </time>
            <h1 class="font-display mt-4 text-4xl md:text-5xl font-medium tracking-tight text-ink leading-tight">
              {post.data.title}
            </h1>
            <p class="mt-6 text-xs text-muted font-mono italic">By {post.data.author}</p>
          </header>

          <div class="prose prose-stone font-sans prose-lg prose-headings:font-display prose-headings:font-medium prose-a:text-orange hover:prose-a:text-ink max-w-none text-ink leading-relaxed">
            <Content />
          </div>
        </div>

        <div class="lg:col-span-4 order-1 lg:order-2 w-full sticky top-24">
          {
            post.data.heroImage && !post.data.has_gallery && (
              <div class="overflow-hidden rounded-sm border border-warm bg-warm/20 shadow-sm w-full">
                <Image
                  src={post.data.heroImage}
                  alt={`Featured cover artwork for ${post.data.title}`}
                  width={500}
                  height={666}
                  loading="eager"
                  class="w-full h-auto object-cover aspect-[3/4] hover:scale-[1.01] transition-transform duration-700 ease-out"
                />
              </div>
            )
          }
        </div>

      </div>

      <div class="w-full pt-8 border-t border-warm/40">
        {
          post.data.has_gallery &&
            post.data.galleryImages &&
            post.data.galleryImages.length > 0 && (
              <div class="w-full">
                <h2 class="text-[10px] font-bold uppercase tracking-widest text-muted mb-8">
                  Project Media Gallery
                </h2>

                <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-8">
                  {post.data.galleryImages.map((img, index) => (
                    <div class="flex-shrink-0 w-[80%] sm:w-[60%] md:w-[35%] aspect-[4/3] snap-start overflow-hidden rounded-sm border border-warm/40 bg-warm/20">
                      <Image
                        src={img}
                        alt={`Gallery artifact documentation index ${index + 1}`}
                        width={800}
                        height={600}
                        class="w-full h-full object-cover hover:scale-[1.01] transition-transform duration-500 ease-out"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )
        }

        <div class="mt-8">
          <a
            href="/blog"
            class="group inline-flex items-center gap-2 text-[11px] font-bold tracking-widest uppercase text-muted hover:text-ink transition-colors duration-200"
          >
            <span class="transition-transform duration-200 group-hover:-translate-x-1">&larr;</span>
            Back to Archive
          </a>
        </div>
      </div>

    </article>
  </section>
</BaseLayout>