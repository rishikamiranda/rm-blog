---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// 1. Generate path segments dynamically for every unique category found in your frontmatter
export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  
  // Extract a flattened, unique list of categories across all blog posts
  const uniqueCategories = [
    ...new Set(allPosts.flatMap((post) => post.data.categories || [])),
  ];

  return uniqueCategories.map((category) => {
    // Filter and sort posts belonging to this specific category loop
    const filteredPosts = allPosts
      .filter((post) => post.data.categories?.includes(category))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category },
      props: { posts: filteredPosts },
    };
  });
}

// 2. Extract parameters and filtered array data passed down from getStaticPaths
const { category } = Astro.params;
const { posts } = Astro.props;

// Formatting helper to display categories beautifully (e.g., "design-thinking" -> "Design Thinking")
const displayTitle = category
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
---

<BaseLayout
  title={`${displayTitle} | Curation Archive`}
  description={`A curated collection of design documentation, notes, and essays focused on ${displayTitle}.`}
>
  
  <!-- HERO HEADER SECTION - Identical to blog layout architecture -->
  <section class="px-8 md:px-16 pt-20 pb-12 md:pt-32 md:pb-16 w-full">
    <div class="max-w-6xl mx-auto">
      <span class="step-line w-12 mb-8"></span>
      <p class="text-xs tracking-widest uppercase text-muted mb-6 font-bold">
        Collection Track &bull; {displayTitle}
      </p>
      
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl leading-none font-medium mb-6 text-ink">
        Filtered by<br/>
        <em class="lowercase">{displayTitle}.</em>
      </h1>
      <p class="text-muted text-xs font-mono max-w-sm leading-relaxed">
        A targeted selection of structural entries and deep workflow records filed under the {displayTitle} taxonomy.
      </p>
    </div>
  </section>

  <!-- IDENTICAL VISUAL GALLERY GRID -->
  <section class="max-w-6xl mx-auto px-8 py-12 md:py-20 w-full">
    <!-- 
      RESPONSIVE GRID TRACKS:
      - grid-cols-1 (Mobile base view)
      - md:grid-cols-2 (Medium tablet space)
      - lg:grid-cols-3 (Large screen portfolio scale)
    -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 md:gap-y-16">
      {
        posts.map((post) => (
          <div class="group cursor-pointer relative w-full">
            <a href={`/blog/${post.data.slug}`} class="block w-full space-y-4">
              
              <!-- Square Image Container -->
              <div class="overflow-hidden aspect-square w-full rounded-sm border border-warm bg-warm shadow-3xs">
                <img
                  src={typeof post.data.heroImage === 'object' ? post.data.heroImage.src : (post.data.heroImage || "https://images.unsplash.com/photo-1499209974431-9dddcece7f88?w=900&q=80")}
                  alt={`Cover visual for ${post.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                />
              </div>

              <!-- Content Metadata & Typography Block -->
              <div class="flex flex-col space-y-2 pt-1">
                
                <!-- Category and Date Timeline Details -->
                <div class="flex items-center gap-2 text-[10px] tracking-widest uppercase text-muted font-bold">
                  <span>{post.data.categories?.[0] || "Reflections"}</span>
                  <span class="text-warm">&bull;</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      year: "numeric",
                    })}
                  </time>
                </div>

                <!-- Post Title -->
                <h2 class="font-display text-xl md:text-2xl font-medium tracking-tight text-ink transition-all duration-300 leading-snug group-hover:italic">
                  {post.data.title}
                </h2>

                <!-- Short Excerpt Description -->
                <p class="text-xs text-muted leading-relaxed line-clamp-2 font-sans pt-0.5">
                  {post.data.description}
                </p>

                <!-- Minimal Action Baseline Link -->
                <div class="pt-2">
                  <span class="text-[9px] tracking-widest uppercase text-ink font-mono font-bold group-hover:text-orange transition-colors duration-200">
                    Read Entry &rarr;
                  </span>
                </div>

              </div>

            </a>
          </div>
        ))
      }
    </div>
  </section>

</BaseLayout>