---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
// Import Astro's optimized image engine
import { Image } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Writing & Journal | Archive"
  description="A complete chronological collection of published text, spatial reflections, and design philosophies."
>
  
  <!-- HERO HEADER SECTION -->
  <section class="px-8 md:px-16 pt-20 pb-12 md:pt-10 md:pb-10 w-full">
    <div class="max-w-6xl mx-auto">
      <span class="step-line w-12 mb-8"></span>
      
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl leading-none font-medium mb-6 text-ink">
        Thoughts <br/>& Reflections
      </h1>
      <p class="text-muted text-sm font-mono leading-relaxed">
        A archive of things I've built, explored and can't stop thinking about.
      </p>
    </div>
  </section>

  <!-- VISUAL GALLERY GRID -->
  <section class="max-w-6xl mx-auto px-8 py-12 md:py-10 w-full">
    <!-- 
      FIXED RESPONSIVE TRACKS: 
      - grid-cols-1 (Mobile base)
      - md:grid-cols-2 (Medium screens/Tablets)
      - lg:grid-cols-3 (Large screens/Desktops)
    -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 md:gap-y-16">
      {
        posts.map((post) => (
          <div class="group cursor-pointer relative w-full">
            <a href={`/blog/${post.data.slug}`} class="block w-full space-y-4">
              
              <!-- Square Image Container -->
              <div class="overflow-hidden aspect-square w-full rounded-sm border border-warm bg-warm shadow-3xs">
                <img
                  src={typeof post.data.heroImage === 'object' ? post.data.heroImage.src : (post.data.heroImage || "https://images.unsplash.com/photo-1499209974431-9dddcece7f88?w=900&q=80")}
                  alt={`Cover visual for ${post.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                />
              </div>

              <!-- Content Metadata & Typography Block -->
              <div class="flex flex-col space-y-2 pt-1">
                
                <!-- Category and Date Timeline Details -->
                <div class="flex items-center gap-2 text-[10px] tracking-widest uppercase text-muted font-bold">
                  <span>{post.data.categories?.[0] || "Reflections"}</span>
                  <span class="text-warm">&bull;</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      year: "numeric",
                    })}
                  </time>
                </div>

                <!-- Post Title -->
                <h2 class="font-display text-xl md:text-2xl font-medium tracking-tight text-ink transition-all duration-300 leading-snug group-hover:italic">
                  {post.data.title}
                </h2>

                <!-- Short Excerpt Description -->
                <p class="text-xs text-muted leading-relaxed line-clamp-2 font-sans pt-0.5">
                  {post.data.description}
                </p>

                <!-- Minimal Action Baseline Link -->
                <div class="pt-2">
                  <span class="text-[9px] tracking-widest uppercase text-ink font-mono font-bold group-hover:text-orange transition-colors duration-200">
                    Read Entry &rarr;
                  </span>
                </div>

              </div>

            </a>
          </div>
        ))
      }
    </div>
  </section>

</BaseLayout>