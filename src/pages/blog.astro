---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
// Import Astro's optimized image engine
import { Image } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Writing & Journal | Archive"
  description="A complete chronological collection of published text, spatial reflections, and design philosophies."
>
  
  <!-- HERO HEADER SECTION - Mirrored directly from your homepage style -->
  <section class="px-8 md:px-16 pt-20 pb-12 md:pt-32 md:pb-16 w-full">
    <div class="max-w-6xl mx-auto">
      <span class="step-line w-12 mb-8"></span>
      <p class="text-md tracking-widest uppercase text-muted mb-6 font-bold">
        Materiality, Ritual & Form
      </p>
      
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl leading-none font-medium mb-6 text-ink">
        The archive of<br/>
        <em>quiet thoughts.</em>
      </h1>
      <p class="text-muted text-md font-mono max-w-lg leading-relaxed">
        A full chronological list of design documentation, architectural reflections, and cultural inquiries.
      </p>
    </div>
  </section>

  <!-- ARCHITECTURAL JOURNAL LIST GRID -->
  <section class="max-w-6xl mx-auto px-8 py-12 md:py-20 w-full">
    <div class="space-y-16 md:space-y-24">
      {
        posts.map((post) => (
          <div class="group cursor-pointer relative border-b border-warm/60 pb-16 last:border-0 last:pb-0">
            <a href={`/blog/${post.data.slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
              
              <!-- Left Column: Image Canvas with custom frame styling -->
              <div class="md:col-span-5 w-full">
                <div class="overflow-hidden aspect-[16/10] rounded-sm border border-warm bg-warm shadow-2xs">
                  <img
                    src={typeof post.data.heroImage === 'object' ? post.data.heroImage.src : (post.data.heroImage || "https://images.unsplash.com/photo-1499209974431-9dddcece7f88?w=900&q=80")}
                    alt={`Cover visual for ${post.data.title}`}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.015]"
                  />
                </div>
              </div>

              <!-- Right Column: Contextual Typography Spine -->
              <div class="md:col-span-7 flex flex-col justify-center">
                
                <!-- Category, Date & Step-Line Indicator -->
                <div class="flex items-center gap-4 mb-4">
                  <span class="step-line w-6 group-hover:w-10 transition-all duration-300"></span>
                  <div class="text-xs tracking-widest uppercase text-muted font-bold flex items-center gap-2">
                    <span>{post.data.categories?.[0] || "Reflections"}</span>
                    <span class="text-warm">&bull;</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        month: "short",
                        year: "numeric",
                      })}
                    </time>
                  </div>
                </div>

                <!-- Main Post Title with font-display hover mechanics -->
                <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-medium group-hover:italic text-ink transition-all duration-300 leading-tight mb-4">
                  {post.data.title}
                </h2>

                <!-- Short Excerpt Description -->
                <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-xl">
                  {post.data.description}
                </p>

                <!-- Plain Text Inline Read Action -->
                <div class="pt-6">
                  <span class="text-[10px] tracking-widest uppercase text-ink font-mono font-bold group-hover:text-orange border-b border-transparent group-hover:border-orange pb-1 transition-all duration-200">
                    Open Entry &rarr;
                  </span>
                </div>

              </div>

            </a>
          </div>
        ))
      }
    </div>
  </section>

</BaseLayout>