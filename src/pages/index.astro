---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Import the physical portrait asset
import profileImage from '../assets/rishikamiranda.png';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout title="Rishika Miranda | Spatial Design, Architecture & Curation">
  
  <!-- HERO SECTION -->
  <section class="px-8 md:px-16 pt-20 pb-16 md:pt-32 md:pb-24 w-full">
    <div class="max-w-6xl mx-auto">
      <span class="step-line w-12 mb-8"></span>
      
      <!-- UPDATED: Subtle Philosophy Line -->
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl leading-none font-medium mb-8 max-w-5xl text-ink">
        Making sense of the world <br/> through design 
      </h1>

      <!-- UPDATED: Coherent, high-end editorial subtext formatting -->
      <p class="text-muted text-sm font-mono max-w-xl leading-relaxed mt-8">
        Through buildings, objects, travel, art, craftsmanship and culture, I'm constantly collecting ideas about how people live, gather and create meaning. This is where I document them.
      </p>
    </div>
  </section>

  <!-- Structural Design Line Divider -->
  <div class="max-w-6xl mx-auto px-8 w-full mb-12">
    <div class="h-px bg-warm/60 w-full"></div>
  </div>

  <!-- ABOUT SECTION -->
  <section class="max-w-6xl mx-auto px-8 py-16 md:py-24 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
      
      <!-- LEFT COLUMN: Narrative Content Spine -->
      <div class="md:col-span-7 w-full">
        
        <div class="mb-6">
          <span class="step-line w-8 mb-4"></span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-medium italic text-ink leading-tight mb-8 max-w-xl">
          Hi, I am Rishika
        </h2>

        <div class="space-y-6 text-sm text-ink leading-relaxed font-mono">
          <p>
          I’m a Bangalore-based architect and creative lead working across architecture, interiors, storytelling and experiential design.
          Architecture is how I make sense of the world. 
          </p>
          <p>
          Over the years, that has led me far beyond buildings. Into interiors, furniture, travel, art, craft, culture and the many ways people shape the spaces around them.
          Much of my work takes shape through Kyrah Design Studio, while other interests find their way into writing, events, collaborations and the occasional side project.
          This website is a collection of projects, places and ideas that continue to inform how I think, design and create.
            </p>
          
          <div class="pt-4">
            <a href="/about" class="text-xs tracking-widest uppercase text-orange border-b border-orange pb-1 hover:text-ink hover:border-ink transition-colors duration-300 font-bold">
              How I Got Here &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Borderless Portrait Window -->
      <div class="hidden md:flex md:col-span-5 justify-end w-full pt-6">
        <div class="p-4 sm:p-6 w-full max-w-[280px] sm:max-w-xs md:max-w-sm bg-transparent">
          <div class="w-full aspect-[3/4] overflow-hidden bg-warm/30 rounded-2xs border border-stone-200/40 shadow-3xs">
            <Image
              src={profileImage}
              alt="Rishika Miranda editorial portrait"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 ease-out"
            />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- AREAS OF PRACTICE SECTION -->
  <section class="max-w-6xl mx-auto px-8 py-16 md:py-24 w-full">
    <div class="mb-12 text-left">
      <span class="step-line w-8 mb-6"></span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-medium italic text-ink leading-tight mb-8 max-w-xl">
        Areas of Practice
      </h2>
    </div>

    <!-- Monolithic Grid Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-warm border border-warm">
      
      <!-- 01. Built Environments -->
      <div class="bg-paper p-8 group transition-colors duration-300 hover:bg-white/50">
        <div class="flex items-center gap-4 mb-6">
          <span class="step-line w-10 group-hover:w-16 transition-all duration-300"></span>
          <span class="text-xs tracking-widest uppercase text-muted font-bold">01</span>
        </div>
        <h3 class="font-display text-xl font-medium text-ink mb-4">Built Environments</h3>
        <p class="text-xs leading-relaxed text-muted">Comprehensive architectural and interior frameworks developed from deep site context, artisanal heritage, and spatial clarity.</p>
      </div>
      
      <!-- 02. Furniture & Product Design -->
      <div class="bg-paper p-8 group transition-colors duration-300 hover:bg-white/50">
        <div class="flex items-center gap-4 mb-6">
          <span class="step-line w-10 group-hover:w-16 transition-all duration-300"></span>
          <span class="text-xs tracking-widest uppercase text-muted font-bold">02</span>
        </div>
        <h3 class="font-display text-xl font-medium text-ink mb-4">Furniture & Product Design</h3>
        <p class="text-xs leading-relaxed text-muted">Intuitively crafted physical items engineered to complement the physical behaviors, textures, and daily spatial rituals of the end user.</p>
      </div>
      
      <!-- 03. Experience Curation -->
      <div class="bg-paper p-8 group transition-colors duration-300 hover:bg-white/50">
        <div class="flex items-center gap-4 mb-6">
          <span class="step-line w-10 group-hover:w-16 transition-all duration-300"></span>
          <span class="text-xs tracking-widest uppercase text-muted font-bold">03</span>
        </div>
        <h3 class="font-display text-xl font-medium text-ink mb-4">Experience Curation</h3>
        <p class="text-xs leading-relaxed text-muted">Designing premium, cross-disciplinary events that weave together layout design, material culture, food, music, and raw community conversations.</p>
      </div>
    </div>
  </section>

  <!-- JOURNAL WRITING GRID -->
<section class="max-w-6xl mx-auto px-8 py-16 md:py-24 w-full">
  <div class="flex items-end justify-between mb-12">
    <div>
      <span class="step-line w-8 mb-6"></span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-medium italic text-ink leading-tight mb-8 max-w-xl">
        Recent Writings
      </h2>
    </div>
  </div>

  {recentPosts.length === 0 ? (
    <p class="text-sm text-muted italic">No journal articles have been deployed to the content tier yet.</p>
  ) : (
    <>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {/* Show only first 4 posts on small screens, all 6 on larger screens */}
        {recentPosts.slice(0, 6).map((post, index) => (
          // Hide posts 5 and 6 on small screens (visible from sm:grid-cols-2 onwards)
          <div class={`group cursor-pointer relative ${index >= 4 ? 'hidden sm:block' : ''}`}>
            <a href={`/blog/${post.data.slug}`} class="block">
              <div class="overflow-hidden aspect-[4/3] mb-4 rounded-sm border border-warm bg-warm">
                <img
                  src={typeof post.data.heroImage === 'object' ? post.data.heroImage.src : (post.data.heroImage || "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=600&q=80")}
                  alt={post.data.title}
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-101"
                />
              </div>
              <h3 class="font-display text-lg font-medium transition-all duration-300 text-ink leading-snug">
                {post.data.title}
              </h3>
              <p class="text-xs text-muted leading-relaxed mt-1">{post.data.description}</p>
            </a>
          </div>
        ))}
      </div>
      
      {/* All Posts link below the grid */}
      <div class="text-right mt-12">
        <a href="/blog" class="text-xs tracking-widest uppercase text-orange border-b border-orange pb-1 hover:text-ink hover:border-ink transition-colors duration-300 font-bold">
          All Posts &rarr;
        </a>
      </div>
    </>
  )}
</section>

  <!-- CTA COLLABORATION BLOCK -->
  <section class="max-w-6xl mx-auto px-8 py-20 md:py-28 w-full">
    <div class="max-w-2xl">
      <div>
        <span class="step-line w-8 mb-6"></span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-medium italic text-ink leading-tight mb-8 max-w-xl">
          Get in touch
        </h2>
      </div>
      <p class="text-xs text-muted leading-relaxed mb-12 max-w-sm">
        I’m always open to new collaborations, projects and conversations. If you’d like to work together, or just want to say hi, feel free to reach out.
      </p>
      <div class="flex items-center gap-6 flex-wrap">
        <a href="mailto:hello@rishikamiranda.com" class="text-xs tracking-widest uppercase bg-orange text-paper px-8 py-4 hover:bg-ink transition-colors duration-300 font-bold rounded-2xl">
          Book a Session
        </a>
      </div>
    </div>
  </section>

</BaseLayout>