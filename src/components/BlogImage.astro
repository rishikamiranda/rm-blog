---
import { Image } from 'astro:assets';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---
<!-- FIXED: Added lg:hidden to prevent layout duplication on desktop screens -->
<div class="my-10 w-full group lg:hidden">
  <div class="overflow-hidden rounded-sm border border-warm bg-warm/20 w-full">
    <Image 
      src={src} 
      alt={alt} 
      class="w-full h-auto object-cover hover:scale-[1.01] transition-transform duration-700 ease-out"
    />
  </div>
  {caption && <p class="text-[11px] font-mono text-muted mt-3 italic tracking-wide text-left">&bull; {caption}</p>}
</div>