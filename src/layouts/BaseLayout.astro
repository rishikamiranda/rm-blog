---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  articleDate?: string;
}

const { 
  title, 
  description = "Founder, Kyrah Design Studio | Architect & Interior Designer crafting thoughtful luxury homes in Bengaluru.", 
  ogImage = "/og-fallback.png",
  articleDate 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rishikamiranda.com');
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Geist:wght@100..900&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  
  <body class="bg-paper text-ink font-mono antialiased min-h-screen flex flex-col relative">
    <div class="relative z-10 flex flex-col min-h-screen w-full">
      
      <!-- NAVIGATION PANEL -->
      <nav class="w-full flex items-center justify-between px-8 md:px-16 py-6 border-b border-warm sticky top-0 bg-paper/90 backdrop-blur-md z-50">
        <a 
          href="/" 
          class="font-display font-medium text-xl italic tracking-tight text-ink hover:text-orange transition-colors duration-200 z-50" 
          aria-label="Rishika Miranda Home"
        >
          RishikaMiranda
        </a>
        
        <!-- DESKTOP NAV CONTAINER: Hidden on smaller screen targets -->
        <ul class="hidden md:flex gap-8 md:gap-10 text-xs tracking-widest uppercase text-muted font-bold">
          <li><a href="/blog" class="hover:text-ink transition">Reflections</a></li>
          <li><a href="/category/projects" class="hover:text-ink transition">Projects</a></li>
          <li><a href="/category/roamed" class="hover:text-ink transition">Roamed</a></li>
          <li><a href="/category/resources" class="hover:text-ink transition">Resources</a></li>
          <li><a href="/about" class="hover:text-ink transition">About</a></li>
        </ul>

        <!-- MOBILE TRIGGER BUTTON: Toggles via inline structural script -->
        <button 
          id="mobile-menu-toggle" 
          class="flex md:hidden text-ink hover:text-orange focus:outline-none p-2 z-50 cursor-pointer transition-colors duration-300"
          aria-label="Toggle Navigation Tray"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </nav>

      <!-- RESPONSIVE MOBILE MENU OVERLAY: Renders drop-down structural tracking list -->
      <div 
        id="mobile-menu-panel" 
        class="fixed inset-0 bg-paper z-40 hidden flex-col justify-start pt-10 px-8 space-y-8 md:hidden transition-all duration-300 ease-out"
      >
        <span class="step-line w-8 mb-2"></span>
        <ul class="flex flex-col gap-y-6 text-lg tracking-widest uppercase text-muted font-bold">
          <li><a href="/blog" class="mobile-nav-link hover:text-ink transition block py-2">Reflections</a></li>
          <li><a href="/category/projects" class="mobile-nav-link hover:text-ink transition block py-2">Projects</a></li>
          <li><a href="/category/roamed" class="mobile-nav-link hover:text-ink transition block py-2">Roamed</a></li>
          <li><a href="/category/resources" class="mobile-nav-link hover:text-ink transition block py-2">Resources</a></li>
          <li><a href="/about" class="mobile-nav-link hover:text-ink transition block py-2">About</a></li>
        </ul>
      </div>
      
      <!-- MAIN CANVAS -->
      <main class="w-full flex-1 flex flex-col">
        <slot />
      </main>

      <!-- FOOTER -->
      <footer class="w-full border-t border-warm px-8 md:px-16 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mt-auto">
        <div class="text-xs text-muted tracking-widest">
          &copy; {new Date().getFullYear()} — Rishika Miranda. All rights reserved.
        </div>
        
        <div class="flex items-center gap-6 text-xs tracking-widest uppercase text-muted font-bold">
          <a href="https://kyrah.in" target="_blank" rel="noopener noreferrer" class="hover:text-orange transition">kyrah.in</a>
          <a href="https://www.linkedin.com/in/rishika-miranda-163260329/" target="_blank" rel="noopener noreferrer" class="hover:text-orange transition">linkedin</a>
          <a href="https://www.instagram.com/rishikamiranda/" target="_blank" rel="noopener noreferrer" class="hover:text-orange transition">instagram</a>
        </div>
      </footer>
    </div>

    <!-- PURE SECURE VANILLA JS ACCENT TOGGLE ENGINE -->
    <script>
      function initMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const menuPanel = document.getElementById('mobile-menu-panel');
        const openIcon = document.getElementById('menu-icon-open');
        const closeIcon = document.getElementById('menu-icon-close');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        // FIXED: Explicitly verify ALL elements exist to satisfy strict TypeScript checking
        if (!toggleBtn || !menuPanel || !openIcon || !closeIcon) return;

        function toggleMenu() {
          // TypeScript now knows safely that these elements are definitely not null
          const isHidden = menuPanel!.classList.contains('hidden');
          
          if (isHidden) {
            menuPanel!.classList.remove('hidden');
            menuPanel!.classList.add('flex');
            openIcon!.classList.add('hidden');
            closeIcon!.classList.remove('hidden');
            toggleBtn!.setAttribute('aria-expanded', 'true');
            document.body.classList.add('overflow-hidden');
          } else {
            menuPanel!.classList.add('hidden');
            menuPanel!.classList.remove('flex');
            openIcon!.classList.remove('hidden');
            closeIcon!.classList.add('hidden');
            toggleBtn!.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('overflow-hidden');
          }
        }

        toggleBtn.addEventListener('click', toggleMenu);

        navLinks.forEach(link => {
          link.addEventListener('click', () => {
            menuPanel.classList.add('hidden');
            menuPanel.classList.remove('flex');
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('overflow-hidden');
          });
        });
      }

      initMobileMenu();
      document.addEventListener('astro:after-swap', initMobileMenu);
    </script>
  </body>
</html>